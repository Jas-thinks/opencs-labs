{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "OpenCS Labs platform overview: API health and latency, notebook session capacity and spawn performance, practice grader health and database connections. Metrics come from the FastAPI backend (opencs_* series, job=\"opencs-backend\"), kube-state-metrics / node-exporter and postgres_exporter. Alerts: infrastructure/monitoring/prometheus-rules.yaml.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [
        "opencs"
      ],
      "targetBlank": true,
      "title": "OpenCS Labs operations runbook",
      "tooltip": "Alert runbooks and recovery procedures",
      "type": "link",
      "url": "https://github.com/opencs-labs/opencs-labs/blob/main/docs/OPERATIONS.md"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API request rate",
      "description": "Requests per second handled by the FastAPI replicas, by HTTP status class. Source metric: opencs_http_requests_total (backend/app/core/metrics.py).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (status) (rate(opencs_http_requests_total{job=\"opencs-backend\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API error rate (5xx share)",
      "description": "Share of requests answered with a 5xx. Alert threshold: >2% sustained for 5m (OpenCSApiHigh5xxRate).",
