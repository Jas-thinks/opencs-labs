# ---------------------------------------------------------------------------
# OpenCS Labs — environment configuration
# Copy to .env and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Environment: development | production
OPENCE_ENV=development

# --- Core secrets -----------------------------------------------------------
# Shared HS256 signing key for the OpenCS session JWT. The JupyterHub
# authenticator validates the same token, which is how SSO works.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPENCE_JWT_SECRET=dev-only-change-me-please-0000000000000000000000000000
OPENCE_JWT_ISSUER=opencs
OPENCE_SESSION_COOKIE=opencs_session
OPENCE_SESSION_TTL_SECONDS=43200

# --- Database ---------------------------------------------------------------
OPENCE_DATABASE_URL=postgresql+psycopg://opencs:opencs@localhost:5432/opencs
# Used by tests; empty = temporary SQLite database
OPENCE_TEST_DATABASE_URL=

# --- Public URLs ------------------------------------------------------------
# Single browser origin that fronts the app, API and JupyterHub.
OPENCE_PUBLIC_ORIGIN=http://localhost:5173
OPENCE_API_PREFIX=/api/v1
# Where the browser should be sent to log in when a notebook needs auth.
OPENCE_LOGIN_PATH=/login

# --- JupyterHub -------------------------------------------------------------
OPENCE_JUPYTERHUB_URL=http://localhost:8001
OPENCE_JUPYTERHUB_API_URL=http://localhost:8001/hub/api
OPENCE_JUPYTERHUB_API_TOKEN=replace-with-hub-admin-token
# Base URL of the Hub proxy for /user/<name>/ requests. Empty = use
# OPENCE_JUPYTERHUB_URL. Set this when the API and proxy are separate
# listeners (Compose: API 8081, proxy 8000).
OPENCE_JUPYTERHUB_PROXY_URL=http://localhost:8000
OPENCE_JUPYTERHUB_PUBLIC_URL=http://localhost:5173
# How the backend manages notebook servers: hub (JupyterHub REST API) or disabled
OPENCE_NOTEBOOK_BACKEND=hub
# Path where approved datasets are mounted inside user pods
OPENCE_DATASET_MOUNT_PATH=/opt/opencs/datasets

# --- Object storage (MinIO / S3 compatible) ---------------------------------
# Empty = object storage not configured (the stack works without it; only
# scripts/sync_datasets.py uses S3). Start MinIO with --profile storage.
OPENCE_S3_ENDPOINT=
OPENCE_S3_ACCESS_KEY=opencs
OPENCE_S3_SECRET_KEY=opencs-dev-secret
OPENCE_S3_BUCKET=opencs-datasets
OPENCE_S3_REGION=us-east-1
# Local directory that is materialised read-only for notebook pods
OPENCE_DATASET_SERVING_DIR=./datasets/serving

# --- Authentication ---------------------------------------------------------
# dev = email+password accounts created by scripts/seed.py (development only)
# oidc = institutional OpenID Connect provider
OPENCE_AUTH_MODE=dev
OPENCE_OIDC_ISSUER=
OPENCE_OIDC_CLIENT_ID=
OPENCE_OIDC_CLIENT_SECRET=

# --- Grading sandbox --------------------------------------------------------
# docker     = local dev / single-host Compose (needs the Docker socket)
# kubernetes = production (short-lived Job in OPENCE_GRADER_K8S_NAMESPACE)
# disabled   = no automated evaluation
OPENCE_GRADER=docker
OPENCE_GRADER_IMAGE=opencs/analytics:1.0.0
OPENCE_GRADER_TIMEOUT_SECONDS=90
OPENCE_GRADER_MEMORY=1g
OPENCE_GRADER_CPUS=1
# Kubernetes sandbox settings (used only when OPENCE_GRADER=kubernetes).
OPENCE_GRADER_K8S_NAMESPACE=opencs-grading
OPENCE_GRADER_DATASET_PVC=opencs-datasets

# --- Rate limiting ----------------------------------------------------------
OPENCE_RATE_LIMIT_ENABLED=true
OPENCE_RATE_LIMIT_LAUNCH_PER_MINUTE=10
OPENCE_RATE_LIMIT_EVALUATE_PER_MINUTE=6

# --- Frontend (build-time) --------------------------------------------------
VITE_API_BASE=/api/v1
VITE_NOTEBOOK_ORIGIN=

# --- JupyterHub container (dev stack) --------------------------------------
JUPYTERHUB_ADMIN_TOKEN=replace-with-hub-admin-token
OPENCE_NOTEBOOK_IMAGE=opencs/analytics:1.0.0

# --- Compose (single-host) ----------------------------------------------
# Absolute host path to the read-only serving tree. The backend and the grading
# sandbox both bind-mount this same path, so it must be absolute.
DATASETS_SERVING_DIR=/absolute/path/to/opencs-labs/datasets/serving

# Host port overrides
FRONTEND_HOST_PORT=5173
BACKEND_HOST_PORT=8000
JUPYTERHUB_HOST_PORT=8001
POSTGRES_HOST_PORT=5433
MINIO_HOST_PORT=19000
MINIO_CONSOLE_PORT=9001

# Seed demo content on backend start (development only)
OPENCE_SEED_ON_START=true
